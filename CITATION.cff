    website: "https://bestrobotmower.co"
url: "https://bestrobotmower.co/dataset"
repository-code: "https://github.com/yumaheymans/robot-lawn-mower-specs"
license: CC-BY-4.0
keywords:
  - robot lawn mower
  - robotic mower
  - robot mower comparison
  - robot mower specs
  - wire-free robot mower
  - RTK robot mower
